{
  "name": "cmu-web-kilt-mcp",
  "version": "0.2.0",
  "description": "MCP server for the Carnegie Mellon Web Kilt: components, install steps, conventions and a markup check",
  "keywords": [
    "mcp",
    "cmu",
    "carnegie-mellon",
    "web-kilt"
  ],
  "homepage": "https://webkilt.andrew.cmu.edu/",
  "repository": "github:cmu-web/cmu-web-kilt-mcp",
  "license": "BSD-3-Clause",
  "bin": {
    "cmu-web-kilt-mcp": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:node": "node scripts/check-node-version.mjs",
    "check": "npm run check:node && npm run lint && npm run format:check && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@j178/prek": "^0.5.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
